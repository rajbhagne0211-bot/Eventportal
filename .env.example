# ---- SERVER-ONLY (never expose to the browser, never commit .env) ----
FLASK_SECRET_KEY=            # long random string: python -c "import secrets;print(secrets.token_hex(32))"
SUPABASE_URL=                # Project Settings > API > Project URL (not secret, but used server-side)
SUPABASE_SERVICE_ROLE_KEY=   # Settings > API Keys > Secret key (sb_secret_...) or the legacy service_role key. SECRET: bypasses RLS
RAZORPAY_KEY_SECRET=         # Razorpay Dashboard > Account & Settings > API Keys (SECRET)
RAZORPAY_WEBHOOK_SECRET=     # the secret you type when creating the webhook (SECRET)

# ---- Safe for the browser (the backend hands these to the page itself) ----
RAZORPAY_KEY_ID=             # rzp_test_... / rzp_live_... (public key id)
SUPABASE_ANON_KEY=           # not used by this app's browser code; kept for reference only

# ---- App settings ----
APP_BASE_URL=http://127.0.0.1:5000   # public URL; used inside QR codes (use https:// in production)
FLASK_ENV=development                # set to production when deployed
DOCUMENT_BUCKET=astra-documents
MAX_UPLOAD_MB=5
ALLOW_AADHAAR_MASKED=false           # keep false unless the college formally requires it
CORS_ORIGINS=                        # only if the frontend is hosted on a different domain, e.g. https://astra.example.com

# ---- Optional confirmation e-mail (leave SMTP_HOST empty to disable) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
